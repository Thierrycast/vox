# Endereço da speech-api. Há dois caminhos possíveis:
#
# 1) Pelo tailnet (padrão) — funciona de qualquer lugar, sem entrada no hosts.
#    Não passa pelo Traefik, então NÃO pede credencial: qualquer dispositivo do
#    tailnet alcança a API livremente.
VOX_API_URL=http://100.122.39.56:8010
#
# 2) Pela LAN, autenticado pelo panel-auth do Traefik. Só funciona em casa e
#    exige no hosts do Windows:
#       192.168.1.36  speech-api.lab.home
#    O certificado é do "Thierry Lab CA", que esta máquina já confia.
# VOX_API_URL=https://speech-api.lab.home

# Credencial do basicAuth — só necessária no caminho (2).
#
# Recomendado criar um usuário só para o app, para poder revogá-lo sem mexer
# na sua credencial pessoal:
#   docker run --rm httpd:alpine htpasswd -nbB voice-client '<senha>'
# e acrescentar a linha ao panel-auth em
#   /DATA/AppData/traefik-v3/config/dynamic/lab-routes.yml
VOX_API_USER=
VOX_API_PASSWORD=

# Verbosidade dos logs: error, warn, info, debug, trace
VOX_LOG=info
