# Endereço do servidor de voz. Este arquivo é o caminho AVANÇADO — o normal é
# configurar pelo painel do Vox (Preferências → Servidor) ou pelo assistente
# de primeiro uso, que grava em settings.json e vence o que estiver aqui.
#
# Use .env quando quiser fixar isso por fora do app: scripts, deploy
# automatizado, ou só preferência pessoal por arquivo de configuração.
VOX_API_URL=http://100.122.39.56:8010

# Credencial do basicAuth, se o caminho até o servidor exigir. A maioria não
# precisa — o caminho comum é sobre uma rede privada que não passa por nenhum
# proxy autenticado.
VOX_API_USER=
VOX_API_PASSWORD=

# Verbosidade dos logs: error, warn, info, debug, trace
VOX_LOG=info
